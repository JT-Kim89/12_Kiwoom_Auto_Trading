# Default is safe: no real request is sent.
KIWOOM_DRY_RUN=true

# mock uses https://mockapi.kiwoom.com, real uses https://api.kiwoom.com.
KIWOOM_ENV=mock

# Required only when KIWOOM_DRY_RUN=false.
KIWOOM_APP_KEY=your_app_key
KIWOOM_SECRET_KEY=your_secret_key

# Required for real orders, as an extra safety switch.
# KIWOOM_CONFIRM_LIVE_ORDER=BUY_SAMSUNG_005930_DAILY

# Samsung Electronics common stock.
KIWOOM_STOCK_CODE=005930
KIWOOM_QUANTITY=1
KIWOOM_EXCHANGE=KRX

# 3 means market order in Kiwoom REST API.
KIWOOM_TRADE_TYPE=3
KIWOOM_ORDER_PRICE=
KIWOOM_CONDITION_PRICE=

# Scheduler target time in KST.
KIWOOM_ORDER_TIME=15:00
KIWOOM_MAX_LATENESS_MINUTES=15

# Optional comma-separated yyyy-mm-dd list.
KIWOOM_HOLIDAYS=
